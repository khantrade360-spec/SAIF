<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For My Beautiful Nida ❤️</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&family=Great+Vibes&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{

background:linear-gradient(135deg,#120012,#290028,#000);

height:100vh;

overflow:hidden;

display:flex;

justify-content:center;

align-items:center;

color:white;

}

.container{

text-align:center;

z-index:2;

}

h1{

font-family:"Great Vibes",cursive;

font-size:60px;

margin-bottom:20px;

text-shadow:0 0 25px #ff2f92;

}

p{

font-size:18px;

opacity:.9;

margin-bottom:40px;

}

button{

padding:18px 40px;

font-size:20px;

border:none;

border-radius:50px;

background:#ff2f92;

color:white;

cursor:pointer;

transition:.4s;

box-shadow:0 0 30px #ff2f92;

}

button:hover{

transform:scale(1.1);

box-shadow:0 0 50px #ff2f92;

}

.heart{

position:absolute;

color:#ff2f92;

animation:float 8s linear infinite;

opacity:.7;

}

@keyframes float{

0%{

transform:translateY(100vh) scale(.5);

opacity:0;

}

20%{

opacity:1;

}

100%{

transform:translateY(-100px) scale(1.4);

opacity:0;

}

}

.envelope{

display:none;

position:absolute;

width:320px;

height:220px;

background:#d12672;

border-radius:10px;

cursor:pointer;

box-shadow:0 0 30px rgba(255,0,128,.5);

transition:1s;

}

.flap{

position:absolute;

width:100%;

height:100%;

background:#ff4d9d;

clip-path:polygon(0 0,50% 50%,100% 0);

transform-origin:top;

transition:1s;

}

.letter{

position:absolute;

width:280px;

height:180px;

background:white;

left:20px;

top:20px;

padding:20px;

color:#333;

border-radius:10px;

transform:translateY(40px);

transition:1s;

overflow:auto;

}

.show .flap{

transform:rotateX(180deg);

}

.show .letter{

transform:translateY(-120px);

}

</style>

</head>

<body>

<div id="hearts"></div>

<div class="container" id="home">

<h1>For My Beautiful Nida ❤️</h1>

<p>Every heartbeat of mine whispers your name...</p>

<button onclick="openEnvelope()">💌 Open My Heart</button>

</div>

<div class="envelope" id="envelope" onclick="openLetter()">

<div class="flap"></div>

<div class="letter">

<h2 style="color:#ff2f92;">Dear Nida ❤️</h2>

<p>

Happy Girlfriend's Day, my beautiful Nida.

You came into my life like the most beautiful blessing, filling every day with happiness, peace, and love.

Every memory we have created together is priceless to me, and every moment with you becomes my favorite.

Thank you for loving me, believing in me, and making my world brighter.

I promise to keep choosing you, caring for you, and loving you with all my heart.

Forever yours,

❤️

</p>

</div>

</div>

<script>

function openEnvelope(){

document.getElementById("home").style.display="none";

document.getElementById("envelope").style.display="block";

}

function openLetter(){

document.getElementById("envelope").classList.toggle("show");

}

for(let i=0;i<50;i++){

let heart=document.createElement("div");

heart.innerHTML="❤";

heart.className="heart";

heart.style.left=Math.random()*100+"vw";

heart.style.fontSize=(10+Math.random()*30)+"px";

heart.style.animationDuration=(5+Math.random()*8)+"s";

heart.style.animationDelay=Math.random()*5+"s";

document.getElementById("hearts").appendChild(heart);

}

</script>

</body>

</html><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Our Beautiful Memories ❤️</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&family=Great+Vibes&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{
background:linear-gradient(135deg,#090012,#1b001f,#000);
overflow:hidden;
color:white;
text-align:center;
}

h1{
font-family:"Great Vibes",cursive;
font-size:60px;
margin-top:25px;
color:#ff5ea8;
text-shadow:0 0 20px hotpink;
}

.slider{
width:90%;
max-width:420px;
margin:30px auto;
position:relative;
}

.slider img{
width:100%;
height:560px;
object-fit:cover;
border-radius:20px;
box-shadow:0 0 35px hotpink;
transition:1s;
}

.caption{
font-size:22px;
margin-top:25px;
padding:15px;
}

button{
margin-top:30px;
padding:15px 35px;
border:none;
border-radius:50px;
background:#ff2f92;
color:white;
font-size:18px;
cursor:pointer;
box-shadow:0 0 25px hotpink;
}

.heart{
position:absolute;
color:#ff2f92;
animation:float 8s linear infinite;
opacity:.6;
}

@keyframes float{
0%{
transform:translateY(100vh);
opacity:0;
}
20%{
opacity:1;
}
100%{
transform:translateY(-120px);
opacity:0;
}
}

</style>
</head>

<body>

<div id="hearts"></div>

<h1>Our Beautiful Memories ❤️</h1>

<div class="slider">

<img id="photo" src="images/1.jpg">

<div class="caption" id="caption">
The day you made my heart smile forever ❤️
</div>

</div>

<button onclick="nextPhoto()">Next Memory ➜</button>

<script>

const photos=[
"images/1.jpg",
"images/2.jpg",
"images/3.jpg",
"images/4.jpg",
"images/5.jpg",
"images/6.jpg",
"images/7.jpg",
"images/8.jpg",
"images/9.jpg",
"images/10.jpg"
];

const captions=[
"The day you made my heart smile forever ❤️",
"Every picture with you is my favorite memory ❤️",
"My safe place is beside you 🌹",
"You make ordinary moments magical ✨",
"Our smiles tell the story words cannot ❤️",
"My happiest memories always include you 💖",
"You are my peace and my happiness 🌸",
"Every heartbeat whispers your name ❤️",
"I'll always choose you 💍",
"Forever begins with us ❤️"
];

let i=0;

function nextPhoto(){

i++;

if(i>=photos.length)i=0;

document.getElementById("photo").src=photos[i];

document.getElementById("caption").innerHTML=captions[i];

}

for(let j=0;j<40;j++){

let h=document.createElement("div");

h.innerHTML="❤";

h.className="heart";

h.style.left=Math.random()*100+"vw";

h.style.fontSize=(12+Math.random()*25)+"px";

h.style.animationDuration=(5+Math.random()*5)+"s";

document.body.appendChild(h);

}

</script>

</body>
</html>
